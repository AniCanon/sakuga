{
  "name": "@anicanon/sakuga",
  "version": "2.56.0",
  "description": "Sakuga 2.0, AniCanon's design system for the web: tokens, fonts, icons, the core components and AniCanonKit.",
  "keywords": [
    "design-system",
    "design-tokens",
    "react",
    "react-components",
    "ui",
    "ui-components",
    "component-library",
    "typescript",
    "tree-shakeable",
    "accessibility",
    "a11y",
    "dark-mode",
    "theming",
    "icons",
    "anime",
    "manga",
    "video",
    "animation",
    "creative-tools",
    "sakuga",
    "anicanon"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AniCanon/sakuga.git"
  },
  "homepage": "https://sakuga.design",
  "bugs": {
    "url": "https://github.com/AniCanon/sakuga/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts/fonts.css",
    "./icons": "./dist/icons/icons.svg",
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./anicanonkit": {
      "types": "./dist/anicanonkit/index.d.ts",
      "import": "./dist/anicanonkit/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "design:fetch": "node scripts/design-fetch.mjs",
    "build": "npm run -s design:fetch && node scripts/build.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:icons": "npm run -s design:fetch && node scripts/build-icons.mjs",
    "typecheck": "npm run -s design:fetch && tsc -p tsconfig.json --noEmit",
    "test": "npm run -s design:fetch && vitest run",
    "check:treeshake": "node scripts/check-treeshake.mjs",
    "check": "npm run check:public && npm run check:provenance && npm run typecheck && npm run test && npm run check:layers && npm run check:reference && npm run check:components && npm run check:docs && npm run build && npm run check:css && npm run check:treeshake && npm run test:visual",
    "parity": "npm run -s design:fetch && npm run build:tokens && node scripts/need-design.mjs --dev vite --config check/parity/vite.config.mjs",
    "check:reference": "npm run -s design:fetch && node scripts/check-reference.mjs",
    "check:components": "npm run -s design:fetch && node scripts/check-components.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:props": "node scripts/docs-props.mjs",
    "check:public": "node scripts/check-public.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "check:css": "node scripts/check-css-refs.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "ladle": "npm run -s design:fetch && npm run build:tokens && node scripts/need-design.mjs --dev ladle serve",
    "ladle:build": "npm run -s design:fetch && npm run build:tokens && node scripts/need-design.mjs --dev ladle build",
    "test:visual": "npm run -s design:fetch && node scripts/need-design.mjs playwright test",
    "test:visual:update": "npm run -s design:fetch && node scripts/need-design.mjs playwright test e2e/stories.spec.ts --update-snapshots",
    "test:sound": "npm run -s design:fetch && node scripts/need-design.mjs playwright test e2e/sound.spec.ts",
    "prepublishOnly": "npm run check:public && npm run typecheck && npm test && npm run check:layers && npm run check:reference && npm run build && npm run check:css && npm run check:treeshake",
    "profile:renders": "node scripts/profile-renders.mjs",
    "test:render-profiler": "node --test scripts/render-profile-plugin.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "jsdom": "^24.1.3",
    "magic-string": "0.30.21",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "svgo": "4.1.0",
    "typescript": "5.5.4",
    "vite": "5.3.4",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@lexical/history": "0.52.0",
    "@lexical/plain-text": "0.52.0",
    "@lexical/utils": "0.52.0",
    "lexical": "0.52.0"
  }
}
