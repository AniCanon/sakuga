{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@anicanon/sakuga/ui": [
        "./src/ui/index.ts"
      ],
      "@design/*": [
        "./.design/*"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "check",
    ".ladle",
    "e2e"
  ],
  "exclude": [
    "check/treeshake"
  ]
}
